build-info.json
services-macos.json
.hagency-launchd.sh

# Generated by install/install-macos.sh and scripts/build-release-package.sh

# CI test reporter output (uploaded as an artifact, never committed)
test-results.json

# Native Rust build and isolated development state
/target/
/native/.state/
