{
  "name": "hagency",
  "version": "1.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test:dashboard": "vitest run tests/dashboard-console.test.js tests/dashboard-runner-ui.test.js tests/dashboard-agent-detail.test.js tests/dashboard-usage-consistency.test.js tests/dashboard-refresh.test.js tests/dashboard-agent-actions.test.js",
    "dev": "node backend-v2.js",
    "start": "node backend-v2.js",
    "test": "NODE_OPTIONS=--max-old-space-size=4096 node scripts/run-suite-tests.mjs",
    "test:ci": "NODE_OPTIONS=--max-old-space-size=4096 node scripts/run-suite-tests.mjs --reporter=default --reporter=json --outputFile.json=test-results.json",
    "test:watch": "vitest",
    "build:router": "tsc -p tsconfig.router.json",
    "typecheck:router": "tsc -p tsconfig.router.json --noEmit",
    "check:router-build": "bash scripts/check-router-build.sh",
    "check:router-boundary": "node scripts/check-router-boundary.js",
    "check:agent-ops-contract": "node scripts/check-agent-ops-contract.js",
    "check:spec-bindings": "node scripts/check-spec-bindings.js",
    "test:kernel": "bash scripts/run-kernel-tests.sh",
    "check:syntax": "bash scripts/check-syntax.sh",
    "check:cli-contract": "node scripts/check-cli-contract.js",
    "check:remote-package-smoke": "bash scripts/check-remote-package-smoke.sh",
    "check:dep-isolation": "bash scripts/check-dep-isolation.sh",
    "check:architecture-boundaries": "node scripts/check-architecture-boundaries.js",
    "check:multi-side": "bash scripts/verify-multi-side.sh --if-available",
    "check:agent-e2e": "bash scripts/verify-agent-e2e.sh --if-available",
    "report:ci-env": "node scripts/report-ci-env.js",
    "verify:ci": "bash scripts/verify-ci.sh",
    "verify:cd-preflight": "bash scripts/verify-cd-preflight.sh",
    "audit:agent-docs": "node scripts/audit-agent-docs.js",
    "build:remote": "bash scripts/build-remote-package.sh",
    "build:remote:check": "bash scripts/build-remote-package.sh --check",
    "build:remote:sync": "bash scripts/build-remote-package.sh --sync-remote",
    "check:remote-sync": "bash scripts/check-remote-sync.sh",
    "audit:deps": "bash scripts/audit-deps.sh",
    "audit:deps:strict": "bash scripts/audit-deps.sh --strict",
    "audit:baseline": "node scripts/audit-baseline.mjs",
    "audit:baseline:update": "node scripts/audit-baseline.mjs --update",
    "check:undef": "eslint ."
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-nodejs": "^0.4.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "another-json": "0.2.0",
    "better-sqlite3": "13.0.2",
    "express": "^4.21.0",
    "markdown-it": "^15.0.1",
    "matrix-bot-sdk": "^0.8.0",
    "sanitize-html": "^2.17.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.1.2",
    "ajv": "8.18.0",
    "eslint": "^10.8.1",
    "supertest": "^7.2.2",
    "typescript": "7.0.2",
    "vitest": "^4.0.18",
    "espree": "11.2.0"
  },
  "overrides": {
    "fast-uri": "^3.1.6",
    "hono": "^4.13.5",
    "morgan": "^1.12.0",
    "ip-address": "^10.4.0",
    "postcss": "^8.5.25",
    "sanitize-html": "^2.17.7",
    "qs": "^6.16.0"
  }
}
